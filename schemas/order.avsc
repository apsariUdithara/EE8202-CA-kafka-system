{
  "type": "record",
  "name": "Order",
  "namespace": "lk.ac.uor.ee8202.orders",
  "doc": "A purchase transaction, as defined by the EE8202 assignment brief.",
  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "doc": "Unique identifier for the order (e.g. \"1001\", \"1002\")."
    },
    {
      "name": "product",
      "type": "string",
      "doc": "Name of the purchased item (e.g. \"Item1\", \"Item2\")."
    },
    {
      "name": "price",
      "type": "float",
      "doc": "Price of the product."
    }
  ]
}
