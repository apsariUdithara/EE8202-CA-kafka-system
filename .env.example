# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below is the built-in default, so the
# system runs with no .env at all when using the bundled docker-compose stack.
# ---------------------------------------------------------------------------

# --- Kafka / Schema Registry (KAFKA_ prefix) -------------------------------
# Use localhost:29092 from the host, kafka:9092 from inside the compose network.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_ORDERS_TOPIC=orders
KAFKA_DLQ_TOPIC=orders.DLQ
KAFKA_AGGREGATES_TOPIC=orders.aggregates

# --- Producer (PRODUCER_ prefix) -------------------------------------------
PRODUCER_MESSAGE_RATE_PER_SECOND=2.0
# 0 means "run until interrupted".
PRODUCER_MAX_MESSAGES=0
# Share of messages that are valid Avro but fail business validation
# (negative price / blank id) -> routed straight to the DLQ.
PRODUCER_INVALID_PAYLOAD_RATE=0.05
# Share of messages emitted as non-Avro bytes -> deserialization failure.
PRODUCER_CORRUPT_PAYLOAD_RATE=0.03
# PRODUCER_SEED=42

# --- Consumer (CONSUMER_ prefix) -------------------------------------------
CONSUMER_GROUP_ID=order-consumer
CONSUMER_AUTO_OFFSET_RESET=earliest
CONSUMER_MAX_RETRY_ATTEMPTS=4
CONSUMER_RETRY_INITIAL_BACKOFF_S=0.2
CONSUMER_RETRY_BACKOFF_MULTIPLIER=2.0
CONSUMER_RETRY_MAX_BACKOFF_S=5.0
CONSUMER_RETRY_JITTER_RATIO=0.2
# Simulated flakiness of the downstream sink, so retry logic is observable.
CONSUMER_TRANSIENT_FAILURE_RATE=0.15
CONSUMER_PUBLISH_AGGREGATES=true
CONSUMER_AGGREGATE_EMIT_EVERY_N=10
CONSUMER_AGGREGATE_EMIT_INTERVAL_S=5.0

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
